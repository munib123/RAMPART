# ---- Python / backend ----
# Virtual environment
backend/.venv/
.venv/

# Server run logs
backend_server.*.log

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Test / coverage / tooling
.pytest_cache/
coverage/
htmlcov/
.coverage
.mypy_cache/
.ruff_cache/
.python-version

# ---- Environment / secrets ----
# Commit .env.example only; never the real .env or other secret files
.env
.env.local
.env.*
!.env.example

# ---- Frontend (Node) ----
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Tauri / Rust ----
frontend/src-tauri/target/
frontend/src-tauri/gen/
# Cargo.lock is intentionally committed for this application; only the
# generated gen/ and target/ build outputs are ignored.
*.rs.bk

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Knowledge base ----
# Pipeline CODE is tracked. Only the build artifacts are ignored: out/ holds the Chroma
# index plus the intermediate jsonl (~578 MB) and is rebuildable from data/ via run_pipeline.py.
knowledge_base/out/
knowledge_base/**/__pycache__/
knowledge_base/**/*.pyc
knowledge_base/adapters/*.bak

# ---- Local fix snapshots (apply/revert safety net) ----
backend/.fix_snapshots/

# ---- Planfiles -------
docs/**

# ---- opencode (local-only: project guide + skills) ----
AGENTS.md
.opencode/

# ---- graphify knowledge graph (local-only) ----
graphify-out/
.graphifyignore

# ---- Joern runtime (installed by app.services.joern.runtime; ~2 GB) ----
tools/
_rampart_joern_tmp/
workspace/
