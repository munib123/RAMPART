# Copy this file to ".env" (which is git-ignored) and paste your key below.
# The .env is never committed and never logged.
#
# NOTE: a Google AI Studio (Gemini) API key normally looks like "AIzaSy...".
# Get one at https://aistudio.google.com/apikey  - and rotate any key you have shared in chat.

# Default model is gemini-2.5-flash-lite (same as backend/app/config.py and the README).
# Tip: free-tier limits are per-day, per-model. gemini-2.5-flash-lite and gemini-2.5-flash
# currently have free-tier quota; gemini-2.0-flash may return 429 (quota). Switch models or
# enable billing to lift the daily cap.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Free-tier DAILY quotas are per model (reset at midnight Pacific = 12:00 PKT). When GEMINI_MODEL's
# is exhausted the backend fails over to these, in order, for the rest of the process. On
# 2026-09-15 both 2.5 models were exhausted by 23:00 PKT; the ones below still answered.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# --- Supabase / Postgres ---
# The DIRECT host (db.<ref>.supabase.co) is IPv6-ONLY and will NOT work from a machine
# without an IPv6 route. Use the IPv4 session-pooler string instead:
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Sign-in lifetime. A scan run after the token expires is NOT saved (no scan_id), which hides
# Apply / Revert / Verify with CPG for that report. 480 = one working day; 30 for production.
JWT_EXPIRE_MIN=480

# --- Joern CPG phase (logic bugs: IDOR, mass assignment, unchecked quantity, TOCTOU) ---
# Runtime is self-installed under tools/ by:  python -m app.services.joern.runtime --install
# JOERN_ENABLED   auto (default: run when the runtime exists and the target has .py files) | on | off
# JOERN_SERVER    auto (default: one long-lived `joern --server` per backend, ~8 s per scan)
#                 | off (one `joern --script` per scan, ~20-35 s; also the automatic fallback)
# JOERN_SERVER_PORT=8091     JOERN_SERVER_WAIT=0  (seconds a scan waits for a starting sidecar)
# JOERN_TIMEOUT=360          JOERN_LLM_QUOTA=20   (LLM slots reserved for CPG candidates)
# JOERN_HOME= / JOERN_JAVA_HOME=   only if the runtime lives outside tools/
JOERN_ENABLED=auto
JOERN_SERVER=auto
# JOERN_PACK      auto (default: flask -> flask-sqlite3, django -> django, else _base) | a pack id | a path to a .json
#                 `_base` is the no_vocab_pack ablation. See backend/app/services/joern/vocab/schema.json.
# JOERN_PACK_ALLOW_UNLISTED=1   load a pack whose digest is not in vocab/packs/digests.json (authoring only)
JOERN_PACK=auto
