{
  "pack_id": "_base",
  "schema_version": 3,
  "authored_from": "hand_written",
  "description": "The token lists the rules were measured with: for the four P2 rules exactly what rules/locators.sc carried as Scala vals (July rules + eight August fixes); since 2026-10 also the framework-neutral values of the call-anchored rules in rules/50-60. Framework-neutral. Every other pack extends this one and can only add. Running with --pack _base IS the no_vocab_pack ablation arm.",
  "slots": {
    "authz_guard": {
      "sink": "guard_text",
      "values": ["is_owner", "owner_id", "check_owner", "has_permission", "authorize", "access_denied", "unauthorized", "forbidden", "abort(401", "abort(403", "permissiondenied", "permission_denied", "httpforbidden", "raise_403", "http_403"],
      "note": "Fix 5: abort(401/abort(403 are authorization outcomes; a bare abort( made a not-found guard read as authz."
    },
    "authn_only": {
      "sink": "guard_text",
      "values": ["current_user", "login_required", "requires_auth", "requires_login", "authenticated", "g.user", "current_identity", "session[", "session.get("],
      "note": "Fix 2: authentication is not authorization. These never suppress IDOR; they become AUTHENTICATED_NOT_AUTHORIZED evidence."
    },
    "lock_guard": {
      "sink": "guard_text",
      "values": ["lock", "acquire", "atomic", "select_for_update", "with_for_update", "for update", "begin(", "savepoint", "transaction", "serializable", "mutex", "semaphore"]
    },
    "allowlist_guard": {
      "sink": "guard_text",
      "values": ["allow", "whitelist", "permitted", "allowed_fields", "safe_fields", "editable_fields", "writable_fields", "fields = (", "fields = [", "only("],
      "note": "Fix 6: names, not syntax. ' in [' matched every membership test in the method."
    },
    "positive_guard": {
      "sink": "guard_text",
      "values": ["max(0", "abs(", "> 0", ">= 0", "> 1"]
    },
    "mass_assign_signal": {
      "sink": "signal_text",
      "values": ["request.form", "request.json", "**data", "**request", "**kwargs"]
    },
    "qty_terms": {
      "sink": "token",
      "values": ["qty", "quantity", "count", "stock"]
    },
    "price_terms": {
      "sink": "token",
      "values": ["price", "total", "subtotal", "balance", "amount"],
      "note": "qty_terms + price_terms is the pre-P5 QTY list, split so the two are disjoint."
    },
    "orm_read_calls": {
      "sink": "call_name",
      "values": ["fetchone", "first", "one", "scalar"]
    },
    "dyn_write_calls": {
      "sink": "call_name",
      "values": ["setattr"]
    },
    "mapping_iter_calls": {
      "sink": "call_name",
      "values": ["items", "to_dict", "keys", "values"]
    },
    "commit_calls": {
      "sink": "call_name",
      "values": ["commit"]
    },
    "exec_calls": {
      "sink": "call_name",
      "values": ["execute"]
    },
    "sql_read_kw": {
      "sink": "exec_sql_kw",
      "values": ["SELECT"]
    },
    "sql_write_kw": {
      "sink": "exec_sql_kw",
      "values": ["INSERT", "UPDATE"]
    },
    "sql_delete_kw": {
      "sink": "exec_sql_kw",
      "values": ["DELETE"]
    },
    "id_param_exact": {
      "sink": "param_exact",
      "values": ["id"]
    },
    "id_param_suffix": {
      "sink": "param_suffix",
      "values": ["_id"]
    },
    "scoped_read_calls": {
      "sink": "call_name",
      "values": []
    },
    "queryset_hooks": {
      "sink": "call_name",
      "values": []
    },
    "object_permission_hooks": {
      "sink": "call_name",
      "values": []
    },
    "route_markers": {
      "sink": "signal_text",
      "values": [".route("],
      "note": "P7. Framework-neutral: a decorator call containing .route( registers the wrapped function."
    },
    "request_sources": {
      "sink": "origin_text",
      "values": ["request.args", "request.form", "request.values", "request.json", "request.get_json", "request.data", "request.files", "request.cookies", "request.headers"],
      "note": "2026-10. The WSGI-style request attributes (Flask/Werkzeug, and request.data in DRF). Framework packs add their own spellings (Django request.GET/POST/META/body)."
    },
    "http_client_calls": {
      "sink": "call_path",
      "values": ["requests.get", "requests.post", "requests.put", "requests.patch", "requests.delete", "requests.head", "requests.options", "requests.request", "urllib.request.urlopen", "urlopen", "httpx.get", "httpx.post", "httpx.put", "httpx.patch", "httpx.delete", "httpx.head", "httpx.request", "httpx.stream"]
    },
    "url_guard": {
      "sink": "guard_text",
      "values": ["urlparse(", "urlsplit(", "netloc", "allowed_host", "allowed_domain", "trusted_host", "is_safe_url", "url_has_allowed_host_and_scheme"]
    },
    "file_sink_calls": {
      "sink": "call_path",
      "values": ["open", "io.open", "codecs.open", "send_file", "os.remove", "os.unlink", "os.rmdir", "shutil.rmtree", "shutil.copy", "shutil.copyfile", "shutil.move"],
      "note": "send_from_directory is NOT a sink: it is the safe API (it joins with safe_join)."
    },
    "path_guard": {
      "sink": "guard_text",
      "values": ["secure_filename", "safe_join", "basename(", "commonpath(", "is_relative_to(", "startswith("],
      "note": "realpath/abspath/normpath alone are not guards: they canonicalise, they do not contain. The containment test is the startswith/commonpath that follows them."
    },
    "auth_check_calls": {
      "sink": "call_name",
      "values": ["check_password_hash", "check_password", "verify_password", "checkpw", "compare_digest", "authenticate", "check_credentials", "verify_credentials"],
      "note": "Only checks that RETURN their verdict. Checks that raise on failure (DRF check_object_permissions, perform_authentication) are correct to call as a statement and must never be listed."
    },
    "auth_check_terms": {
      "sink": "token",
      "values": ["login", "password", "credential", "authenticat"],
      "note": "A project function counts as a check only when its name has one of these AND it returns None/False on one path and a computed value on another (the Scala tests the returns)."
    },
    "credential_terms": {
      "sink": "token",
      "values": ["password", "passwd", "pwd", "passphrase", "secret", "api_key", "apikey"]
    },
    "xxe_kwargs": {
      "sink": "kwarg_flow",
      "values": ["xmlparser:resolve_entities=true", "xmlparser:no_network=false", "xmlparser:load_dtd=true", "xmlparser:huge_tree=true", "xmlpullparser:resolve_entities=true", "xmlpullparser:no_network=false", "iterparse:resolve_entities=true", "iterparse:load_dtd=true"],
      "note": "lxml.etree parser keywords (https://lxml.de/api/lxml.etree.XMLParser-class.html)."
    },
    "debug_kwargs": {
      "sink": "kwarg_flow",
      "values": ["run:debug=true", "run_simple:use_debugger=true", "run_simple:use_evalex=true"],
      "note": "Flask app.run(debug=...) and Werkzeug run_simple(use_debugger/use_evalex=...). Known false positive: asyncio.run(debug=True)."
    }
  }
}
